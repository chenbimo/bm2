import {
  "chensuiyi/bm2/protocol",
  "moonbitlang/core/async",
  "moonbitlang/core/async/aqueue",
  "moonbitlang/core/async/process",
  "moonbitlang/core/async/semaphore",
  "moonbitlang/core/async/signal",
  "moonbitlang/core/async/socket",
  "chensuiyi/bm2/config",
  "chensuiyi/bm2/core",
  "chensuiyi/bm2/i18n",
  "chensuiyi/bm2/ipc",
  "chensuiyi/bm2/fsx",
  "chensuiyi/bm2/proc",
  "chensuiyi/bm2/utils",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

options(
  "allow-experimental-packages": [
    "moonbitlang/core/async",
    "moonbitlang/core/async/aqueue",
    "moonbitlang/core/async/process",
    "moonbitlang/core/async/semaphore",
    "moonbitlang/core/async/signal",
    "moonbitlang/core/async/socket",
  ],
)

pkgtype(kind: "executable")
